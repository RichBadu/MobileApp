<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Views.Categories.CategoryAddPage"
             xmlns:viewmodels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewmodels:CategoryAddViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="20">
            <VerticalStackLayout Padding="20,5,20,15" Spacing="15" HorizontalOptions="Center">
                <VerticalStackLayout.WidthRequest>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="Android" Value="-1"/>
                        <On Platform="WinUI" Value="800"/>
                    </OnPlatform>
                </VerticalStackLayout.WidthRequest>
              
                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,20">
                    <!-- Close Button -->
                    <Frame Grid.Column="0"
                       WidthRequest="40"
                       HeightRequest="40"
                       CornerRadius="20"
                       BackgroundColor="White"
                       Padding="0"
                       HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                        </Frame.GestureRecognizers>
                        <Label Text="✕" 
                           FontSize="24"
                           TextColor="{StaticResource ThemeColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </Frame>

                    <!-- Title -->
                    <Label Grid.Column="1"
                       Text="Add Category" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="{StaticResource ThemeColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
                </Grid>

                <!-- Icon Input -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Poster" 
                       FontSize="14" 
                       TextColor="#666"
                       HorizontalOptions="Center"/>

                <Frame WidthRequest="100"
           HeightRequest="100"
           CornerRadius="50"
           BackgroundColor="{Binding Color}"
           Padding="0"
           HasShadow="True">
                    <Entry Text="{Binding Icon}" 
               FontSize="40"
               MaxLength="2"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               BackgroundColor="Transparent"
               TextColor="White"
               />
                </Frame>
            </VerticalStackLayout>
            <!-- Type Picker -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Type" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <Frame CornerRadius="12" 
                       BackgroundColor="White" 
                       Padding="15,10"
                       HasShadow="True"
                       MinimumHeightRequest="50">
                        <Picker SelectedItem="{Binding Type}" 
                            FontSize="16"
                            TextColor="#0D1B2A"
                            VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Expense</x:String>
                                <x:String>Income</x:String>
                            </Picker.Items>
                        </Picker>
                    </Frame>
                </VerticalStackLayout>


                <!-- Name Input -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Name" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <Frame CornerRadius="12" 
                       BackgroundColor="White" 
                       Padding="15"
                       HasShadow="True">
                        <Entry Text="{Binding Name}" 
                           FontSize="16"
                           Placeholder="e.g. Food, Transport"
                           TextColor="{StaticResource ThemeColor}"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Budget Input -->
                <VerticalStackLayout Spacing="5"  IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Expense}">
                <Label Text="Monthly Budget EUR (optional)" 
                       FontSize="14" 
                       TextColor="#666"/>
                <Frame CornerRadius="12" 
                       BackgroundColor="White" 
                       Padding="15"
                       HasShadow="True">
                        <Entry Text="{Binding MonthlyBudget}" 
                           Keyboard="Numeric"
                           FontSize="16"
                          TextColor="{StaticResource ThemeColor}"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Color Picker -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Color" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <CollectionView ItemsSource="{Binding PresetColors}"
                               HeightRequest="50">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Frame WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   BackgroundColor="{Binding .}"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame"
                                               Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryAddViewModel}}, Path=Color}"
                                               Value="{Binding .}">
                                            <Setter Property="BorderColor" Value="#0D1B2A"/>
                                            <Setter Property="Scale" Value="1.2"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryAddViewModel}}, Path=SetColorCommand}"
                                        CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Preview Card -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Preview" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <Frame CornerRadius="15" 
                       BackgroundColor="White" 
                       Padding="15"
                       HasShadow="True">
                        <Grid ColumnDefinitions="50,*,Auto">
                            <!-- Icon Preview -->
                            <Frame Grid.Column="0"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               BackgroundColor="{Binding Color}"
                               Padding="0"
                               HasShadow="False">
                                <Label Text="{Binding Icon}" 
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            </Frame>

                            <!-- Name & Budget Preview -->
                            <VerticalStackLayout Grid.Column="1" 
                                            Spacing="3"
                                            VerticalOptions="Center"
                                            Margin="10,0">
                                <Label Text="{Binding Name}" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0D1B2A">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" 
                                               Binding="{Binding Name}" 
                                               Value="">
                                            <Setter Property="Text" Value="Category Name"/>
                                            <Setter Property="TextColor" Value="#999"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding MonthlyBudget, StringFormat='Budget: € {0:N2}'}" 
                                   FontSize="13"
                                   TextColor="#666"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- Save Button -->
                <Button Text="Save Category" 
                    BackgroundColor="{StaticResource ThemeColor}"
                    TextColor="White"
                    HeightRequest="55"
                    CornerRadius="12"
                    FontSize="18"
                    FontAttributes="Bold"
                    Command="{Binding SaveCategoryCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,10,0,0"/>

            </VerticalStackLayout>
    </ScrollView>

</ContentPage>