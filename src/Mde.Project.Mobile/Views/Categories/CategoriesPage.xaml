<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Views.Categories.CategoriesPage"
             xmlns:viewmodels="clr-namespace:Mde.Project.Mobile.ViewModels"
             xmlns:models="clr-namespace:Mde.Project.Mobile.Core.Models;assembly=Mde.Project.Core"
             xmlns:helpers="clr-namespace:Mde.Project.Mobile.Core.Helpers;assembly=Mde.Project.Core"
             x:DataType="viewmodels:CategoriesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">
    <Grid>
        <Grid HorizontalOptions="Center">
            <Grid.WidthRequest>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android" Value="-1"/>
                    <On Platform="iOS" Value="-1"/>
                    <On Platform="WinUI" Value="900"/>
                </OnPlatform>
            </Grid.WidthRequest>
            <Grid RowDefinitions="Auto,*" Padding="20,20,20,50">


                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,10,0,20">

                    <!-- Back Button -->
                    <Frame Grid.Column="0"
                       WidthRequest="40"
                       HeightRequest="40"
                       CornerRadius="20"
                       BackgroundColor="White"
                       Padding="0"
                       HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </Frame.GestureRecognizers>
                        <Label Text="←" 
                           FontSize="30"
                           TextColor="{StaticResource ThemeColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </Frame>

                    <!-- Title -->
                    <Label Grid.Column="1"
                       Text="Categories" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="{StaticResource ThemeColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                </Grid>



                <CollectionView ItemsSource="{Binding GroupedCategories}"
                           IsGrouped="True"
                           Grid.Row="1">


                    <!-- Group Header -->
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="helpers:CategoryGroup">
                            <Label Text="{Binding TypeGroup}" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource ThemeColor}"
                               Margin="0,15,0,10"/>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <!-- Category Items -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <Frame CornerRadius="12"
                               BackgroundColor="White"
                               Padding="15"
                               Margin="0,0,0,10"
                               HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=CategoryTappedCommand}"
                                    CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="50,*,Auto">
                                    <!-- Icon -->
                                    <Frame Grid.Column="0"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       BackgroundColor="{Binding Color}"
                                       Padding="0"
                                       HasShadow="False">
                                        <Label Text="{Binding Icon}" 
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    </Frame>

                                    <!-- Name & Budget -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                    Spacing="3"
                                                    VerticalOptions="Center"
                                                    Margin="10,0">
                                        <Label Text="{Binding Name}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#0D1B2A"/>

                                        <!-- Budget-->
                                        <Label Text="{Binding MonthlyBudget, StringFormat='Budget: € {0:N2}',TargetNullValue='No budget'}" 
                                           FontSize="13"
                                           TextColor="#666"
                                           IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Expense}"/>
                                    </VerticalStackLayout>

                                    <!-- Arrow Icon -->
                                    <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="24"
                                       TextColor="#999"
                                       VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" 
                                        HorizontalOptions="Center"
                                        Spacing="10"
                                        Margin="0,50">
                            <Label Text="📁" FontSize="60" HorizontalOptions="Center"/>
                            <Label Text="No categories yet" 
                               FontSize="16"
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                            <Label Text="Tap + to add one" 
                               FontSize="13"
                               TextColor="#999" 
                               HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- FAB -->
        <Frame WidthRequest="60"
               HeightRequest="60"
               CornerRadius="30"
               BackgroundColor="{StaticResource ThemeColor}"
               HasShadow="True"
               Padding="0"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="20">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddCategoryCommand}"/>
            </Frame.GestureRecognizers>

            <Label Text="+" 
                   FontSize="32"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Frame>
    </Grid>


</ContentPage>