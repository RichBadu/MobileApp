<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Views.Settings.SettingsPage"
             xmlns:viewmodels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewmodels:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">


    <ScrollView Padding="20,50,20,15">
        <VerticalStackLayout Padding="20,5,20,15" Spacing="15">
            <VerticalStackLayout.WidthRequest>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android" Value="-1"/>
                    <On Platform="WinUI" Value="900"/>
                </OnPlatform>
            </VerticalStackLayout.WidthRequest>
           
                <Label Text="Settings" 
                   FontSize="28" 
                   FontAttributes="Bold"
                   TextColor="{StaticResource ThemeColor}"
                   Margin="0,10,0,20"
                   VerticalOptions="Center"/>

                <!-- Profile Section -->
                <Frame CornerRadius="15"
                   BackgroundColor="White"
                   Padding="20"
                   HasShadow="True">
                    <Grid ColumnDefinitions="60,*" ColumnSpacing="15">
                    
                        <Frame Grid.Column="0"
                           WidthRequest="60"
                           HeightRequest="60"
                           CornerRadius="30"
                           Padding="0"
                           HasShadow="False">
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#667eea" Offset="0.0" />
                                    <GradientStop Color="#764ba2" Offset="1.0" />
                                </LinearGradientBrush>
                            </Frame.Background>
                            <Label Text="👤" 
                               FontSize="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        </Frame>

                        <!-- Name & Email -->
                        <VerticalStackLayout Grid.Column="1" 
                                        Spacing="5"
                                        VerticalOptions="Center">
                            <Label Text="{Binding UserName}" 
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#0D1B2A"/>
                            <Label Text="{Binding UserEmail}" 
                               FontSize="14"
                               TextColor="#666"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Notifications & Sync Section -->
                <Label Text="NOTIFICATIONS &amp; SYNC" 
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#999"
                   Margin="0,10,0,0"/>
            <Frame CornerRadius="12"
                     BackgroundColor="#FFF3CD"
                     Padding="15"
                     HasShadow="False"
                     BorderColor="#FFC107"
                     Margin="20">       
                <Frame.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean">
                        <On Platform="Android" Value="False"/>
                        <On Platform="WinUI" Value="True"/>
                    </OnPlatform>
                </Frame.IsVisible>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                         Text="ℹ️"
                         FontSize="20"
                         VerticalOptions="Start"/>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Notifications Not Available" 
             FontSize="14"
             FontAttributes="Bold"
             TextColor="#856404"/>
                        <Label TextColor="#856404" 
             FontSize="13"
             LineBreakMode="WordWrap"
             Text="Desktop notifications are not supported on Windows. Budget alerts will show as dialog messages when you're using the app."/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame CornerRadius="15"
                   BackgroundColor="White"
                   Padding="0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="0">

                    <!-- Push Notifications Toggle -->
                    <Grid Padding="20" ColumnDefinitions="Auto,*,Auto">
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="True"/>
                                <On Platform="WinUI" Value="False"/>
                            </OnPlatform>
                        </Grid.IsVisible>

                        <Label Grid.Column="0"
                               Text="🔔" 
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2"
                                           VerticalOptions="Center"
                                           Margin="15,0,0,0">
                            <Label Text="Push Notifications" 
                                   FontSize="16"
                                   TextColor="#0D1B2A"/>
                            <Label Text="Enable all notifications" 
                                   FontSize="12"
                                   TextColor="#999"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding NotificationsEnabled}"
                                OnColor="{StaticResource ThemeColor}"
                                VerticalOptions="Center"/>
                    </Grid>
                    <!-- Divider (only visible on mobile) -->
                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="20,0">
                        <BoxView.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="True"/>
                                <On Platform="iOS" Value="True"/>
                                <On Platform="WinUI" Value="False"/>
                            </OnPlatform>
                        </BoxView.IsVisible>
                    </BoxView>


                    <!-- Daily Reminder Toggle -->
                    <Grid Padding="20" ColumnDefinitions="Auto,*,Auto">
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="True"/>
                                <On Platform="WinUI" Value="False"/>
                            </OnPlatform>
                        </Grid.IsVisible>

                        <Label Grid.Column="0"
                               Text="⏰" 
                               FontSize="24"
                               VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2"
                                           VerticalOptions="Center"
                                           Margin="15,0,0,0">
                            <Label Text="Daily Reminder" 
                                   FontSize="16"
                                   TextColor="#0D1B2A"/>
                            <Label Text="Remind me at 20:00 to add transactions" 
                                   FontSize="12"
                                   TextColor="#999"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="2"
                                IsToggled="{Binding DailyReminderEnabled}"
                                OnColor="{StaticResource ThemeColor}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Divider (only visible on mobile) -->
                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="20,0">
                        <BoxView.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="True"/>
                                <On Platform="WinUI" Value="False"/>
                            </OnPlatform>
                        </BoxView.IsVisible>
                    </BoxView>
                    <!-- Budget Warning Toggle -->
                    <Grid Padding="20" ColumnDefinitions="Auto,*,Auto">
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="True"/>
                                <On Platform="WinUI" Value="False"/>
                            </OnPlatform>
                        </Grid.IsVisible>

                        <Label Grid.Column="0"
                               Text="⚠️" 
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2"
                                           VerticalOptions="Center"
                                           Margin="15,0,0,0">
                            <Label Text="Budget Warnings" 
                                   FontSize="16"
                                   TextColor="#0D1B2A"/>
                            <Label Text="Alert when reaching exceeding your budget" 
                                   FontSize="12"
                                   TextColor="#999"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding BudgetWarningEnabled}"
                                OnColor="{StaticResource ThemeColor}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Divider (only visible on mobile) -->
                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="20,0">
                        <BoxView.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="True"/>
                                <On Platform="WinUI" Value="False"/>
                            </OnPlatform>
                        </BoxView.IsVisible>
                    </BoxView>

      
                    <!-- Divider before Auto-Sync (only visible on Windows) -->
                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="20,0">
                        <BoxView.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean">
                                <On Platform="Android" Value="False"/>
                                <On Platform="WinUI" Value="True"/>
                            </OnPlatform>
                        </BoxView.IsVisible>
                    </BoxView>


                    <!--Auto-Sync Toggle -->
                    <Grid Padding="20" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="🔄" 
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2"
                                           VerticalOptions="Center"
                                           Margin="15,0,0,0">
                            <Label Text="Auto Sync" 
                                   FontSize="16"
                                   TextColor="#0D1B2A"/>
                            <Label Text="Sync automatically when opening app" 
                                   FontSize="12"
                                   TextColor="#999"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding AutoSyncEnabled}"
                                OnColor="{StaticResource ThemeColor}"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Frame>


            <!-- Settings Section -->
                <Label Text="Recurring" 
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#999"
                   Margin="0,10,0,0"/>

                <Frame CornerRadius="15"
                   BackgroundColor="White"
                   Padding="0"
                   HasShadow="True">
                    <VerticalStackLayout Spacing="0">

                        <!-- Recurring Transactions -->
                        <Grid Padding="20" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewRecurringTransactionsCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                               Text="🔁" 
                               FontSize="24"
                               VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                               Text="Recurring Transactions" 
                               FontSize="16"
                               TextColor="#0D1B2A"
                               VerticalOptions="Center"
                               Margin="15,0,0,0"/>
                            <Label Grid.Column="2"
                               Text="›" 
                               FontSize="24"
                               TextColor="#999"
                               VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Sync Section -->
                <Label Text="SYNC" 
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#999"
                   Margin="0,10,0,0"/>

                <Frame CornerRadius="15"
                   BackgroundColor="White"
                   Padding="20"
                   HasShadow="True">
                    <VerticalStackLayout Spacing="15">

                        <!-- Last Sync-->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Last sync" 
                               FontSize="14"
                               TextColor="#666"/>
                            <Label Text="{Binding LastSyncText}" 
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ThemeColor}"/>
                        </VerticalStackLayout>

                        <!-- Manual Sync Button -->
                        <Button Text="🔄 Sync Now"
                            Command="{Binding ManualSyncCommand}"
                            BackgroundColor="{StaticResource ThemeColor}"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"/>

                        <!-- Syncing Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsSyncing}"
                                     Color="{StaticResource ThemeColor}"
                                     IsVisible="{Binding IsSyncing}"/>

                    </VerticalStackLayout>
                </Frame>
            
      
            <!-- Logout Button -->
                <Button Text="Logout"
                    BackgroundColor="#FF6B6B"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="12"
                    FontSize="16"
                    FontAttributes="Bold"
                    Command="{Binding LogoutCommand}"
                    Margin="0,10,0,0"/>

     
           


            </VerticalStackLayout>

    </ScrollView>


</ContentPage>