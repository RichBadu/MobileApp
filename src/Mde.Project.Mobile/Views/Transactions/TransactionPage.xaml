<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Views.Transactions.TransactionPage"
             xmlns:viewmodels="clr-namespace:Mde.Project.Mobile.ViewModels"
             xmlns:models="clr-namespace:Mde.Project.Mobile.Core.Models;assembly=Mde.Project.Core"
             xmlns:helpers="clr-namespace:Mde.Project.Mobile.Core.Helpers;assembly=Mde.Project.Core"
             x:DataType="viewmodels:TransactionViewModel"
             x:Name="thisPage"
             BackgroundColor="#F8FAFC">
   

  
    <Grid>
        <Grid HorizontalOptions="Center">
            <Grid.WidthRequest>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android" Value="-1"/>
                    <On Platform="WinUI" Value="900"/>
                </OnPlatform>
            </Grid.WidthRequest>

            <Grid RowDefinitions="Auto,Auto,auto,*" Padding="20,5,20,15">
                <Frame Grid.Row="0" CornerRadius="10"
                    Padding="10"
                    BackgroundColor="#FFF3CD"
                    BorderColor="Transparent"
                   HasShadow="False"
                    IsVisible="{Binding HasPendingRecurring}">
                    <Label Text="🔄 Swipe down to refresh – new recurring transactions available"
                       TextColor="#856404"
                       FontSize="13"/>
                </Frame>
            
                <Label Grid.Row="1"
                   Text="Transactions"
                   
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource ThemeColor}"
                   Margin="0,10,0,20"/>

                <!-- Filter Chips -->
                <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,0,0,20">

                    <Frame Padding="12" CornerRadius="20" BorderColor="Transparent" BackgroundColor="#F5F5F5">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding SelectedFilter}" Value="All">
                                <Setter Property="BackgroundColor" Value="{StaticResource ThemeColor}"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                        </Frame.GestureRecognizers>

                        <Label Text="All" FontSize="13" TextColor="#666">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="All">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Frame>

                    <!-- Expenses Filter -->
                    <Frame Padding="12"
                       CornerRadius="20"
                       BackgroundColor="#F5F5F5"
                       HasShadow="False"
                       BorderColor="Transparent"
                       >
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding SelectedFilter}" Value="Expenses">
                                <Setter Property="BackgroundColor" Value="{StaticResource ThemeColor}"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Expenses"/>
                        </Frame.GestureRecognizers>

                        <Label Text="Expenses" FontSize="13" TextColor="#666">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="Expenses">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Frame>

                    <!-- Income Filter -->
                    <Frame Padding="12"
                       CornerRadius="20"
                       BackgroundColor="#F5F5F5"
                       HasShadow="False"
                       BorderColor="Transparent"
                       >
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding SelectedFilter}" Value="Income">
                                <Setter Property="BackgroundColor" Value="{StaticResource ThemeColor}"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Income"/>
                        </Frame.GestureRecognizers>

                        <Label Text="Income" FontSize="13" TextColor="#666">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="Income">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Frame>
                </HorizontalStackLayout>

                <!-- Transactions List -->
                <RefreshView Grid.Row="3" 
                             Command="{Binding RefreshDataCommand}" 
                             IsRefreshing="{Binding IsRefreshing}">
                    <Grid>

                        <!--ANDROID CollectionView -->
                        <CollectionView ItemsSource="{Binding GroupedTransactions}"
                                        IsGrouped="True"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.IsVisible>
                                <OnPlatform x:TypeArguments="x:Boolean">
                                    <On Platform="Android" Value="True"/>
                                    <On Platform="WinUI" Value="False"/>
                                </OnPlatform>
                            </CollectionView.IsVisible>

                            <CollectionView.GroupHeaderTemplate>
                                <DataTemplate x:DataType="helpers:TransactionGroup">
                                    <Label Text="{Binding DateGroup}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource ThemeColor}"
                                           Margin="0,10,0,5"/>
                                </DataTemplate>
                            </CollectionView.GroupHeaderTemplate>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionRecord">
                                    <Frame CornerRadius="12"
                                           BackgroundColor="White"
                                           Padding="15"
                                           Margin="0,0,0,10"
                                           HasShadow="True">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.TransactionTappedCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#0D1B2A"/>
                                                <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy HH:mm}'}" 
                                                       FontSize="12"
                                                       TextColor="#999"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" 
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Income">
                                                        <Setter Property="TextColor" Value="#4CAF50"/>
                                                        <Setter Property="Text" Value="{Binding Amount, StringFormat='+ € {0:N2}'}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Expense">
                                                        <Setter Property="TextColor" Value="#FF6B6B"/>
                                                        <Setter Property="Text" Value="{Binding Amount, StringFormat='- € {0:N2}'}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <VerticalStackLayout VerticalOptions="Center" 
                                                     HorizontalOptions="Center"
                                                     Spacing="10"
                                                     Margin="0,50">
                                    <Label Text="📝" FontSize="60" HorizontalOptions="Center"/>
                                    <Label Text="No transactions found" 
                                           FontSize="16"
                                           TextColor="Gray" 
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <!--WINDOWS ListView -->
                        <ListView ItemsSource="{Binding GroupedTransactions}"
                                  IsGroupingEnabled="True"
                                  HasUnevenRows="True"
                                  SeparatorVisibility="None"
                                  SelectionMode="None">
                            <ListView.IsVisible>
                                <OnPlatform x:TypeArguments="x:Boolean">
                                    <On Platform="Android" Value="False"/>
                                    <On Platform="WinUI" Value="True"/>
                                </OnPlatform>
                            </ListView.IsVisible>

                            <ListView.GroupHeaderTemplate>
                                <DataTemplate x:DataType="helpers:TransactionGroup">
                                    <ViewCell>
                                        <Label Text="{Binding DateGroup}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource ThemeColor}"
                                               Margin="0,10,0,5"/>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.GroupHeaderTemplate>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionRecord">
                                    <ViewCell>
                                        <Frame CornerRadius="12"
                                               BackgroundColor="White"
                                               Padding="15"
                                               Margin="0,0,0,10"
                                               HasShadow="True">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding BindingContext.TransactionTappedCommand, Source={x:Reference thisPage}}"
                                                    CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                                    <Label Text="{Binding Name}" 
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="#0D1B2A"/>
                                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy HH:mm}'}" 
                                                           FontSize="12"
                                                           TextColor="#999"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" 
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Income">
                                                            <Setter Property="TextColor" Value="#4CAF50"/>
                                                            <Setter Property="Text" Value="{Binding Amount, StringFormat='+ € {0:N2}'}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Expense">
                                                            <Setter Property="TextColor" Value="#FF6B6B"/>
                                                            <Setter Property="Text" Value="{Binding Amount, StringFormat='- € {0:N2}'}"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </Frame>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>
                </RefreshView>
            </Grid>
        </Grid>
        
        <Frame WidthRequest="60"
               HeightRequest="60"
               CornerRadius="30"
               BackgroundColor="{StaticResource ThemeColor}"
               HasShadow="True"
               Padding="0"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="20">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddTransactionCommand}"/>
            </Frame.GestureRecognizers>

            <Label Text="+" 
                   FontSize="32"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Frame>

    </Grid>

</ContentPage>