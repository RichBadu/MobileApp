<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Views.Transactions.TransactionAddPage"
              xmlns:viewmodels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewmodels:TransactionAddViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="20">
        <VerticalStackLayout Padding="20,5,20,15" Spacing="15">
            <VerticalStackLayout.WidthRequest>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android" Value="-1"/>
                    <On Platform="WinUI" Value="900"/>
                </OnPlatform>
            </VerticalStackLayout.WidthRequest>
          
                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,20">
                    <!-- Close Button -->
                    <Frame Grid.Column="0"
                       WidthRequest="40"
                       HeightRequest="40"
                       CornerRadius="20"
                       BackgroundColor="White"
                       Padding="0"
                       HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                        </Frame.GestureRecognizers>
                        <Label Text="✕" 
                           FontSize="24"
                           TextColor="{StaticResource ThemeColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </Frame>

                    <!-- Title -->
                    <Label Grid.Column="1"
                       Text="Add Transaction" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="{StaticResource ThemeColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
                </Grid>

                <!-- Type Toggle -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!-- Expense Button -->
                    <Frame Grid.Column="0"
                       CornerRadius="12"
                       Padding="0"
                       HasShadow="True"
                       BorderColor="{StaticResource ThemeColor}">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Expense">
                                <Setter Property="BackgroundColor" Value="#FF6B6B"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Income">
                                <Setter Property="BackgroundColor" Value="White"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTypeCommand}" CommandParameter="Expense"/>
                        </Frame.GestureRecognizers>

                        <Label Text="Expense" 
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="15">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Expense">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Income">
                                    <Setter Property="TextColor" Value="#666"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Frame>

                    <!-- Income Button -->
                    <Frame Grid.Column="1"
                       CornerRadius="12"
                       Padding="0"
                       HasShadow="True"
                       BorderColor="{StaticResource ThemeColor}">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Income">
                                <Setter Property="BackgroundColor" Value="#4CAF50"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Type}" Value="Expense">
                                <Setter Property="BackgroundColor" Value="White"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTypeCommand}" CommandParameter="Income"/>
                        </Frame.GestureRecognizers>

                        <Label Text="Income" 
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="15">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Income">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Expense">
                                    <Setter Property="TextColor" Value="#666"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Frame>
                </Grid>
            <!-- Name Input -->

            <VerticalStackLayout Spacing="5">
                    <Label Text="Name" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <Frame CornerRadius="12" 
                       BackgroundColor="White" 
                       Padding="15"
                       HasShadow="True">
                        <Entry Text="{Binding Name}" 
                       FontSize="16"
                       TextColor="{StaticResource ThemeColor}"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Amount Input -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Amount (EUR)" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <Frame CornerRadius="12" 
                       BackgroundColor="White" 
                       Padding="15"
                       HasShadow="True">
                        <Entry Text="{Binding Amount}" 
                           Keyboard="Numeric"
                           FontSize="24"
                           FontAttributes="Bold"
                           Placeholder="EUR"
                           TextColor="{StaticResource ThemeColor}"/>
                    </Frame>
                </VerticalStackLayout>


                <!-- Category Picker -->
                <VerticalStackLayout Spacing="5">
                <Label Text="Select a category" 
    FontSize="14" 
    TextColor="#666"/>
                <Frame CornerRadius="12" 
       BackgroundColor="White" 
       Padding="15,10"
       HasShadow="True"
       MinimumHeightRequest="50">
                    <Picker ItemsSource="{Binding Categories}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding SelectedCategory}"
            FontSize="16"
            TextColor="#0D1B2A"
            VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

                <!-- Date Picker -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Select a date" 
                       FontSize="14" 
                       TextColor="#666"/>
                    <Frame CornerRadius="12" 
       BackgroundColor="White" 
       Padding="15,10"
       HasShadow="True"
       MinimumHeightRequest="50">
                    <DatePicker Date="{Binding Date}" 
                FontSize="16"
                TextColor="#0D1B2A"
                VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

                <!-- Time Picker -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Select a time" 
                       FontSize="14" 
                       TextColor="#666"/>
                <Frame CornerRadius="12" 
       BackgroundColor="White" 
       Padding="15,10"
       HasShadow="True"
       MinimumHeightRequest="50">
                    <TimePicker Time="{Binding Time}" 
                FontSize="16"
                TextColor="#0D1B2A"
                VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

                <!-- Description Input -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Description (optional)" 
                       FontSize="14" 
                     TextColor="#666"  />
                    <Frame CornerRadius="12" 
                       BackgroundColor="White" 
                       Padding="15"
                       HasShadow="True">
                        <Entry Text="{Binding Description}" 
                           FontSize="16"
                           TextColor="{StaticResource ThemeColor}" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Photo Section -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Receipt Photo (Optional)" 
           FontSize="16" 
           FontAttributes="Bold"
           TextColor="{StaticResource ThemeColor}"
           Margin="0,10,0,5"/>

                    <!-- Photo Preview (Visible when photo exists) -->
                    <Frame CornerRadius="12"
           BackgroundColor="White"
           Padding="10"
           HasShadow="True"
           IsVisible="{Binding HasPhoto}"
           Margin="0,0,0,10">

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <!-- Photo Image -->
                            <Image Grid.Row="0"
                   Source="{Binding PhotoPath}"
                   Aspect="AspectFit"
                   HeightRequest="200"
                   BackgroundColor="#F5F5F5"/>

                            <!-- Remove Photo Button -->
                            <Button Grid.Row="1"
                    Text="Remove Photo"
                    BackgroundColor="#FF6B6B"
                    TextColor="White"
                    CornerRadius="8"
                    Command="{Binding RemovePhotoCommand}"/>
                        </Grid>
                    </Frame>

                    <!-- Photo Buttons (Visible when NO photo) -->
                    <Grid ColumnDefinitions="*,*" 
          ColumnSpacing="10"
          IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}}">

                        <!-- Take Photo Button -->
                        <Button Grid.Column="0"
                Text="📸 Take Photo"
                BackgroundColor="{StaticResource ThemeColor}"
                TextColor="White"
                CornerRadius="8"
                Command="{Binding TakePhotoCommand}"/>

                        <!-- Pick Photo Button -->
                        <Button Grid.Column="1"
                Text="🖼️ Pick Photo"
                BackgroundColor="{StaticResource ThemeColor}"
                TextColor="White"
                CornerRadius="8"
                Command="{Binding PickPhotoCommand}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Save Button -->
                <Button Text="Save Transaction" 
                    BackgroundColor="{StaticResource ThemeColor}"
                    TextColor="White"
                    HeightRequest="55"
                    CornerRadius="12"
                    FontSize="18"
                    FontAttributes="Bold"
                    Command="{Binding SaveTransactionCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,10,0,0"/>

            </VerticalStackLayout>

    </ScrollView>
</ContentPage>